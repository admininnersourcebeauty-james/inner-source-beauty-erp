<section class="isb-testimonials" id="isb-testimonials-{{ section.id }}" data-isb-testimonials>
  <div class="page-width">
    <h2 class="isb-testimonials__heading">{{ section.settings.heading | escape }}</h2>

    <div class="isb-testimonials__carousel">
      <button type="button" class="isb-testimonials__nav isb-testimonials__nav--prev" aria-label="Previous testimonial" data-isb-testimonial-prev>
        {% render 'isb-icon-chevron-left' %}
      </button>

      <div class="isb-testimonials__track" data-isb-testimonial-track>
        {%- for block in section.blocks -%}
          <blockquote class="isb-testimonial{% unless forloop.first %} isb-testimonial--hidden-mobile{% endunless %}" {{ block.shopify_attributes }} data-isb-testimonial-slide>
            <span class="isb-testimonial__quote-mark" aria-hidden="true">“</span>
            {%- if block.settings.quote != blank -%}
              <p class="isb-testimonial__quote">{{ block.settings.quote | escape }}</p>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <cite class="isb-testimonial__author">— {{ block.settings.author | escape }}</cite>
            {%- endif -%}
            <div class="isb-testimonial__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- assign rating = block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <span class="isb-testimonial__star{% if i > rating %} isb-testimonial__star--empty{% endif %}">★</span>
              {%- endfor -%}
            </div>
          </blockquote>
        {%- endfor -%}
      </div>

      <button type="button" class="isb-testimonials__nav isb-testimonials__nav--next" aria-label="Next testimonial" data-isb-testimonial-next>
        {% render 'isb-icon-chevron-right' %}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ISB Testimonials",
  "tag": "section",
  "class": "isb-section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT OUR CUSTOMERS SAY"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "These products have completely transformed my skin. I feel more confident than ever!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Jessica L."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISB Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "These products have completely transformed my skin. I feel more confident than ever!",
            "author": "Jessica L.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The quality is incredible. My skin has never looked or felt better.",
            "author": "Amanda K.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "You can feel the care in every product. Highly recommend!",
            "author": "Sophia M.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
