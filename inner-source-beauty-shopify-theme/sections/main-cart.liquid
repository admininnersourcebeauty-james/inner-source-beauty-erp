<section class="main-cart page-width">
  <div class="main-cart__inner">
    <h1>Your cart</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        <table class="main-cart__table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.variant.title == 'Default Title' -%}
                    <br><small>{{ item.variant.title | escape }}</small>
                  {%- endunless -%}
                </td>
                <td>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}">
                </td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <p><strong>Subtotal:</strong> {{ cart.total_price | money }}</p>

        <div class="main-cart__actions">
          <button type="submit" name="update" class="main-cart__update">Update cart</button>
          <button type="submit" name="checkout" class="main-cart__checkout">Checkout</button>
        </div>
      </form>
    {%- else -%}
      <p>Your cart is empty.</p>
      <p><a href="{{ routes.all_products_collection_url }}">Continue shopping</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "section-main-cart",
  "settings": []
}
{% endschema %}
